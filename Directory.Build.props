<Project>
  <!--
    Repo-wide build settings. src/Directory.Build.props (version and identity) imports this
    file explicitly, because MSBuild stops at the nearest Directory.Build.props and would
    otherwise never reach this one for projects under src/.
  -->

  <!--
    Issue #650: audit transitive packages too, and fail the build on a high or
    critical advisory (NU1903, NU1904) instead of printing a warning nobody reads. The way out is a pinned
    version: add a PackageVersion in Directory.Packages.props and a direct PackageReference
    in the project that pulls the vulnerable package in. Moderate reports (NU1902) stay warnings.
    Emergency override for a one-off build: pass -p:NuGetAudit=false.
  -->
  <PropertyGroup>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
