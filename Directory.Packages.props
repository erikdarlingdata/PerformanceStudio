<Project>
  <!-- NuGet package versions are managed centrally for src/, tests/, and server/. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="BlackwellSystems.Gcf" Version="1.1.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Meziantou.Framework.Win32.CredentialManager" Version="3.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- The SDK manages this package implicitly for the installer; only the legacy
         SSMS project has an explicit reference that needs a central version. -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" Condition="'$(MSBuildProjectName)' == 'PlanViewer.Ssms'" />
    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" />
    <!-- Issue #650: Microsoft.VisualStudio.SDK 17.14.40265 (the newest 17.x) brings in MessagePack
         2.5.192 (GHSA-hv8m-jj95-wg3x, high, patched in 2.5.301). PlanViewer.Ssms references this
         directly so 2.5.307 wins. Drop this pin and the Ssms reference once a Microsoft.VisualStudio.SDK
         release depends on MessagePack 2.5.301 or later. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="Repl" Version="0.11.0" />
    <PackageVersion Include="Repl.Mcp" Version="0.11.0" />
    <PackageVersion Include="Repl.Testing" Version="0.11.0" />
    <PackageVersion Include="ScottPlot.Avalonia" Version="5.1.59" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <!-- Issue #650: Microsoft.Data.SqlClient 7.1.1 brings in Pkcs 9.0.18
         (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate; both cover 9.0.0 through
         9.0.20). PlanViewer.Core references this directly so 10.0.13 wins in
         project.assets.json and in the planview CLI package. The desktop app's self-contained
         publish takes Pkcs from the ASP.NET Core runtime pack instead, which the audit never
         sees. Drop this pin and the Core reference once SqlClient depends on Pkcs 9.0.21 or
         later (10.0.13 or later on 10.x). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
