<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Direct ref pins the native SQLite on the current SQLitePCLRaw 3.x line.
         Originally added because Microsoft.Data.Sqlite floored SQLitePCLRaw at 2.1.11,
         whose bundled SQLite is vulnerable to CVE-2025-6965 (GHSA-2m69-gcr7-jv3q).
         As of Microsoft.Data.Sqlite 10.0.12 the floor is 2.1.12 (CVE-fixed), so this
         ref is no longer load-bearing for that CVE - kept because 3.x bundles a much
         newer SQLite (3.53.x vs 2.1.12's 3.50.x) and this is the runtime-verified
         configuration (full CRUD against the 3.x native layer). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
