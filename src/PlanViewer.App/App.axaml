<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlanViewer.App.App"
             Name="Performance Studio"
             RequestedThemeVariant="Dark">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Performance Studio" Click="OnAboutClicked" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>

        <!-- Scrollbars are slim overlay rails that expand on hover. This half turns the
             overlay on; the geometry that makes it grabbable is in Application.Resources
             below, and neither half is correct without the other.

             Fluent reserves layout space for a scrollbar whenever AllowAutoHide is false,
             so a pane built from nested scrollers surrenders a strip per scroller. The
             plan view was showing three horizontal bars stacked at once. With auto-hide
             on, ScrollViewer's own theme spans the content presenter under both bars
             (Grid.ColumnSpan and RowSpan go to 2), so bars float over content instead of
             shoving it around.

             #464 is why this is not simply "auto-hide back on". That issue was the mirror
             complaint: Fluent's idle thumb is scaleX(0.125) of a 16px bar, which is 2
             physical pixels, and the report said the thing you need to grab is "a couple
             of pixels tall until after you have found it". Turning auto-hide off fixed the
             grab and bought the stacking. Redefining the geometry buys both - see the
             resources below for the arithmetic.

             Set explicitly rather than left to the Fluent default, because the default is
             precisely what #464 overrode here and the decision should be visible. -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="True"/>
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="True"/>
        </Style>

        <!-- DataGrid does not scroll through a ScrollViewer, so the ScrollBar rule above
             cannot reach its bars: PART_HorizontalScrollbar and PART_VerticalScrollbar are
             bare ScrollBars inside its own template. There is no DataGrid.AllowAutoHide to
             set, but the template binds each bar's AllowAutoHide to the ATTACHED ScrollViewer
             property on the grid, so setting that here is what reaches them. -->
        <Style Selector="DataGrid">
            <Setter Property="ScrollViewer.AllowAutoHide" Value="True"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PlanViewer.App/Themes/DarkTheme.axaml"/>
                <ResourceInclude Source="avares://PlanViewer.App/Themes/BarChartConfig.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Scrollbar geometry, overriding Fluent's own resources of these names.
                 Application.Resources outranks resources a theme contributes through
                 Application.Styles, which is the same lever DarkTheme pulls to repaint
                 SystemAccentColor.

                 Fluent's numbers are 16px with an idle scale of 0.125, so 2px of rail.
                 These are 14px with an idle scale of 0.5, so 7px of rail that is always
                 drawn and always grabbable, opening to the full 14px under the pointer.
                 That is the macOS overlay-scrollbar shape, and 7 logical px stays workable
                 at high display scaling where 2px did not.

                 KEEP THESE IN STEP. The idle rail is ScrollBarSize times the scale factor,
                 and it must not fall below 6px or #464 is back. Only the scale differs from
                 Fluent's own resource; the translate is theirs, is applied in the scaled
                 space, and merely holds the rail a hair off the edge. -->
            <x:Double x:Key="ScrollBarSize">14</x:Double>
            <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.5) translateX(-2px)</TransformOperations>
            <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.5) translateY(-2px)</TransformOperations>
        </ResourceDictionary>
    </Application.Resources>
</Application>
