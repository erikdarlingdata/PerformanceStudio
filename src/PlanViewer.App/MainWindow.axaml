<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PlanViewer.App.Controls"
        x:Class="PlanViewer.App.MainWindow"
        Title="Performance Studio — SQL Server Execution Plan Analyzer"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="480"
        WindowState="Maximized"
        Icon="avares://PlanViewer.App/EDD.ico"
        Background="{DynamicResource BackgroundBrush}"
        DragDrop.AllowDrop="True">

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource BackgroundDarkBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="New _Query" Click="NewQuery_Click"
                          InputGesture="Ctrl+N"/>
                <MenuItem Header="Open Q_uery..." Click="OpenQuery_Click"
                          InputGesture="Ctrl+Shift+O"/>
                <MenuItem Header="_Save Query..." Click="SaveQuery_Click"
                          InputGesture="Ctrl+S"/>
                <Separator/>
                <!-- Named so a test can hold these gestures against the ones the query tab's
                     empty state prints beside the same two actions. -->
                <MenuItem x:Name="OpenPlanMenuItem" Header="_Open .sqlplan..." Click="OpenFile_Click"
                          InputGesture="Ctrl+O"/>
                <MenuItem x:Name="PastePlanXmlMenuItem" Header="_Paste Plan XML" Click="PasteXml_Click"
                          InputGesture="Ctrl+V"/>
                <Separator/>
                <MenuItem x:Name="RecentPlansMenu" Header="_Recent Plans"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"
                          InputGesture="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Settings" Click="Settings_Click"/>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Performance Studio" Click="About_Click"/>
                <Separator/>
                <MenuItem x:Name="McpStatusMenuItem" Header="MCP Server: Off" IsEnabled="False"/>
            </MenuItem>
        </Menu>

        <!-- Top-level TabControl for query sessions and plan files -->
        <Grid>
            <TabControl x:Name="MainTabControl"
                        Background="{DynamicResource BackgroundBrush}" Padding="0">
                <!-- The stock TabControl lays its headers out in a WrapPanel, so tabs stack into
                     a second and third row as they accumulate: eight tabs made three rows at
                     laptop width, and with the session toolbar under them that was six rows of
                     chrome above the query. The strip is one row that scrolls instead.

                     Retemplated rather than restyled because the stock template has no
                     ScrollViewer to turn on: PART_ItemsPresenter sits bare in the DockPanel,
                     and an ItemsPanelTemplate can only hold a Panel, so a horizontal panel on
                     its own would put the overflow tabs out of reach instead of on a second row.
                     Everything else is the stock arrangement, and the selected-tab underline is
                     untouched: it lives in TabItem's own template (PART_SelectedPipe), not here.

                     The rail stays on this one, unlike the session toolbar's: dragging it is the
                     affordance that says there are more tabs off-screen. Visible rather than Auto,
                     though, and that is not a preference. App.axaml turns AllowAutoHide off
                     app-wide, and Fluent only spans the content presenter under the scrollbars
                     when auto-hide is ON, so with it off a rail occupies its own grid row: on Auto
                     the strip would grow by the rail's height at the exact moment a tab tipped it
                     into overflow, and shrink back when one closed, shoving the toolbar, the
                     sub-tab row and the editor down and up with it. That is the shift the session
                     toolbar refuses for itself, and it would be no better here. Constant height at
                     every tab count is worth the rail always showing. (If scrollbars ever go back
                     to overlay auto-hide, Auto becomes the better setting.) -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <DockPanel>
                                <!-- Dock is hardcoded where the stock template binds TabStripPlacement:
                                     a horizontal scrolling strip only makes sense along the top, and
                                     this template is scoped to this one control, which is always Top.

                                     TabStripScroll lives in the template's namescope, so FindControl
                                     from the window returns null for it; the handler below reaches it
                                     through sender. And the handler is only reachable at all because
                                     ScrollContentPresenter leaves a wheel unhandled when it changed no
                                     offset. Turn vertical scrolling on here, or set
                                     IsScrollChainingEnabled=False, and the plain-wheel handler goes
                                     dead with no error to say so. -->
                                <ScrollViewer Name="TabStripScroll" DockPanel.Dock="Top"
                                              PointerWheelChanged="TabStrip_PointerWheel"
                                              HorizontalScrollBarVisibility="Visible"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsPresenter Name="PART_ItemsPresenter"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                </ScrollViewer>
                                <ContentPresenter Name="PART_SelectedContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding SelectedContent}"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                <!-- A tab header is [label][close button] in a StackPanel. Capping the LABEL is
                     what trims it: a StackPanel measures its children with infinite width along
                     its orientation, so a MaxWidth on the TabItem alone never makes the label
                     ellipsize, it just pushes the close button off the end of a long name. 170
                     plus the button and padding lands the header near 220.

                     The selector is anchored at this control by name on purpose. Avalonia matches
                     selectors against the LOGICAL tree, and a query session's own sub-tab headers
                     are the same TabItem, StackPanel, TextBlock shape one level further down.
                     Every looser spelling of this rule (and hosting it on the items panel, which
                     is not in the headers' logical chain at all and so reaches nothing) either
                     misses these headers or also caps the sub-tabs inside every session. -->
                <TabControl.Styles>
                    <Style Selector="TabControl#MainTabControl &gt; TabItem &gt; StackPanel &gt; TextBlock">
                        <Setter Property="MaxWidth" Value="170"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                    <!-- Renaming swaps the label for a TextBox in the same slot (StartRename), and
                         an uncapped one grows the header, and the whole strip, with every keystroke. -->
                    <Style Selector="TabControl#MainTabControl &gt; TabItem &gt; StackPanel &gt; TextBox">
                        <Setter Property="MaxWidth" Value="170"/>
                    </Style>
                </TabControl.Styles>
            </TabControl>

            <!-- Empty state overlay -->
            <Border x:Name="EmptyOverlay" Background="{DynamicResource BackgroundBrush}"
                    IsVisible="True" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="Performance Studio" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Ctrl+N to open a new query session"
                               FontSize="14"
                               Foreground="{DynamicResource ForegroundBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Ctrl+O to open a .sqlplan or .sql file"
                               FontSize="14"
                               Foreground="{DynamicResource ForegroundBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Ctrl+V to paste execution plan XML"
                               FontSize="14"
                               Foreground="{DynamicResource ForegroundBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="or drag and drop files"
                               FontSize="14"
                               Foreground="{DynamicResource ForegroundBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
